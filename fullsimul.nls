to setup-stairs
  ask patches[
    if pxcor >= 38 and pxcor <= 49 and pycor >= 42 and pycor <= 60 [set pcolor grey set p_type "stair"]
    if pxcor >= 164 and pxcor <= 179 and pycor >= 48 and pycor <= 60 [set pcolor grey set p_type "stair"]
    if pxcor = 43 and pycor >= 43 and pycor <= 60 [set pcolor black set p_type "walls"]
    if pxcor >= 164 and pxcor <= 179 and pycor = 54 [set pcolor black set p_type "walls"]
  ]
  
end

to setup-rooms-and-corridors
  ask patches[
    if pxcor >= 40 and pxcor <= 73 and pycor >= 82 and pycor <= 110 [set pcolor 9 set p_type "room"]
    if pxcor >= 76 and pxcor <= 105 and pycor >= 82 and pycor <= 110 [set pcolor 9 set p_type "room"]
    if pxcor >= 107 and pxcor <= 140 and pycor >= 78 and pycor <= 110 [set pcolor 9 set p_type "room"]
    if pxcor >= 142 and pxcor <= 166 and pycor >= 78 and pycor <= 110 [set pcolor 9 set p_type "room"]
    
   
  ]
  
end

;; ----------------- go --------------------------------------------
to go

  if count civilians = 0 
  [
    stop
  ]

  ask civilians
  [
   
   civilian-movement
   reached-safe-zone
   follow-signs
    ;know-path
  ]
  
  

  tick
end
