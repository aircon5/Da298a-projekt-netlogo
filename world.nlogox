<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[
globals
[
  exit
  A-counter
  B-counter
  testnumber
  available-exit
]


breed [civilians civilian]
breed [nodes node]

nodes-own [
  directions
]
civilians-own [
  current-node
  vision-distance
  vision-angle
  current-direction
  direction-chosen?
  evacuated?
  exited
  following-person
]

patches-own [
  dist
  p_type
]

to setup
  clear-all
  
  
  set A-counter 0
  set B-counter 0
  
  setup-world
  setup-rooms-and-corridors
  
  
  let peopleA random civilians-count print peopleA
  let peopleB random (civilians-count - peopleA) print peopleB 
  let peopleC random (civilians-count - peopleA - peopleB) print peopleC 
  let peopleD random (civilians-count - peopleA - peopleB - peopleC) print peopleD 
  let total (peopleA + peopleB + peopleC + peopleD)
  if total != civilians-count [set peopleA peopleA + civilians-count - total]
  ask n-of (peopleA)  (patches with [plabel = "A" ]  ) [sprout-civilians 1]
  ask n-of (peopleB)  (patches with [plabel = "B" ]  ) [sprout-civilians 1]
  ask n-of (peopleC)  (patches with [plabel = "C" ]  ) [sprout-civilians 1]
  ask n-of (peopleD)  (patches with [plabel = "D" ]  ) [sprout-civilians 1]
  ask civilians
  [
    set color blue
    set shape "person"
    set size 2
    set vision-distance 10
    set vision-angle 134
    set current-direction 0
    set direction-chosen? false
    set evacuated? false
    set exited ""
    set following-person nobody
    
  ]
  

  

  create-nodes 18
  [
    set size 2
    set color 44
   
  ]
  
  setup-sign-direction
   


  check-rooms
  
  reset-ticks
end



to setup-world

  import-pcolors "A3_nr5.png"
  ask patches with [pcolor >= 0 and pcolor <= 9.2 ]
  [
    set pcolor black
    set p_type "walls"
  ]
  ask patches with [pcolor >= 51 and pcolor <= 69 ]
  [
    set pcolor green
    set p_type "doors"
  ]
  ask patches with [pcolor >= 11 and pcolor <= 19 ]
  [
    set pcolor red
    set p_type "exit"
  ]
  ask patches with [pcolor >= 101 and pcolor <= 109 ]
  [
    set pcolor 6
    set p_type "stairs"
  ]
  ask patches with [pcolor >= 111 and pcolor <= 129 ]
  [
    set pcolor 8
    set p_type "stairs"
  ]
  ask patches with [pcolor >= 41 and pcolor <= 49 ]
  [
    set pcolor white
    set p_type "cooridor"
  ]
  ask patches with [pcolor != black and pcolor != green and pcolor != red and pcolor != 6 and pcolor != 8] [ set pcolor white ]
  ask patches with [pcolor = black or pcolor = yellow ] [ set dist 100000 ]

end


to setup-rooms-and-corridors
  ask patches[
    if pxcor >= 40 and pxcor <= 73 and pycor >= 82 and pycor <= 110 [set pcolor 9 set p_type "room" set plabel "A"]
    if pxcor >= 76 and pxcor <= 105 and pycor >= 82 and pycor <= 110 [set pcolor 9 set p_type "room" set plabel "B"]
    if pxcor >= 107 and pxcor <= 140 and pycor >= 78 and pycor <= 110 [set pcolor 9 set p_type "room" set plabel "C"]
    if pxcor >= 142 and pxcor <= 166 and pycor >= 78 and pycor <= 110 [set pcolor 9 set p_type "room" set plabel "D"]
    
   
  ]
  
end

to setup-sign-direction
 ask node (civilians-count)[
    setxy 44 82
    set directions [145]
    set heading 145
  ]
  ask node (civilians-count + 1)[
    setxy 55 62
    set directions [180]
    set heading 180
  ]
  ask node (civilians-count + 2)[
    setxy 100 79
    set directions [180]
    set heading 180
  ]
  ask node (civilians-count + 3)[
    setxy 128 78
    set directions [180]
    set heading 180
  ]
  ask node (civilians-count + 4)[
    setxy 153 78
    set directions [180]
    set heading 180
  ]
  ask node (civilians-count + 5)[
    setxy 50 35
    set directions [315]
    set heading 315
  ]
  ask node (civilians-count + 6)[
    setxy 43 60
    set directions [225]
    set heading 225
  ]
  ask node (civilians-count + 7)[
    setxy 160 61
    set directions [180]
    set heading 180
  ]
  ask node (civilians-count + 8)[
    setxy 158 53
    set directions [120]
    set heading 120
  ]
  ask node (civilians-count + 9)[
    setxy 99 71
    set directions [283]
    set heading 283
  ]
  ask node (civilians-count + 10)[
    setxy 128 70
    set directions [90]
    set heading 90
  ]
  ask node (civilians-count + 11)[
    setxy 74 106
    set directions [225]
    set heading 225
  ]
  ask node (civilians-count + 12)[
    setxy 153 70
    set directions [135]
    set heading 135
  ]
  ask node (civilians-count + 13)[
    setxy 25 60
    set directions [225]
    set heading 225
  ]
  ask node (civilians-count + 14)[
    setxy 178 54
    set directions [315]
    set heading 315
  ]
  ask node (civilians-count + 15)[
    setxy 199 66
    set directions [315]
    set heading 315
  ]
  ask node (civilians-count + 16)[
    setxy 58 80
    set directions [180]
    set heading 180
  ]
end

to check-rooms
  
  let antalA count civilians with [
    [plabel] of patch-here = "A"
  ]
  let antalB count civilians with [
    [plabel] of patch-here = "B"
  ]
  let antalC count civilians with [
    [plabel] of patch-here = "C"
  ]
  let antalD count civilians with [
    [plabel] of patch-here = "D"
  ]
  
  print (word "antalA: " antalA "    antalB: " antalB  "    antalC: " antalC  "   antalD: " antalD )
    
  ifelse (antalA + antalB) - (antalC + antalD) < 10
  [
    print "normalt1"
  ]
  [
    ifelse (antalB > (antalA + 20) and not((antalC + antalD) > (civilians-count / 2)) )or (antalC + antalD) < (civilians-count / 10)
    [
      print "b till 2"
      update-direction-on-node 99 71 90
    ]
    [
      ifelse (antalC > (antalD + 20) and not((antalA + antalB) > (civilians-count / 2))) or (antalA + antalB) < (civilians-count / 10)
      [
      print "c till 1"
      update-direction-on-node 128 70 270
      ]
      [
        print "normalt2"
      ]
    ]
  ]
end

to go 
  if count civilians = 0 
  [
    stop
  ]

  
  move-civilians
  
  
  
  
  if (exit-signs)
  [
    update-direction-on-node 199 66 225
    update-direction-on-node 178 54 225
    update-direction-on-node 158 53 0
    update-direction-on-node 160 61 320
    update-direction-on-node 153 70 270
    update-direction-on-node 128 70 270
    update-direction-on-node 99 71 285
  ]
  
  tick
  
end


to move-civilians
  ask civilians [
    
    if [plabel] of patch-here = "A"
    [
      face patch (random 6 + 41) 81
      not-move-in-wall
      set color cyan
    ]
    if [plabel] of patch-here = "B"
    [
      face patch (random 6 + 98) 79
      not-move-in-wall
      set color cyan
    ]
    if [plabel] of patch-here = "C"
    [
      face patch (random 6 + 125) 77
      not-move-in-wall
      set color cyan
    ]
    if [plabel] of patch-here = "D"
    [
      face patch (random 6 + 151) 77
      not-move-in-wall
      set color cyan
    ]
    
    ifelse [pcolor] of patch-here = red [
      set evacuated? true
      die
    ]
    [
      on-stairs-right
      on-stairs-left
      on-cooridor
      
      move
    ]

  ]
end

to follow-node-direction
  let signs nodes in-cone vision-distance vision-angle
  ;let doors patches in-radius 10 with [pcolor = green]
  
  ifelse any? signs [
    let target-node min-one-of signs [distance myself]
    
    set current-node target-node
    ifelse distance current-node > 3
    [
      set current-direction towards current-node
      set heading current-direction
    ]
    [
      set current-direction one-of [directions] of target-node
      set direction-chosen? true
      set heading current-direction
    ]
    
    not-move-in-wall
    
    set color violet
  ]
  [
    ifelse direction-chosen? [
      set heading current-direction
      not-move-in-wall
    ]
    [
;       ifelse any? doors 
;       [
;         let target min-one-of doors [distance myself]
;         face target
;         not-move-in-wall
;         set color orange
;       ]
;       [
        set heading random 360
        not-move-in-wall
;      ]
    ]
  ]
  
end

to follow-person-infront
  let person-to-follow one-of other civilians in-cone 3 90 
  ifelse person-to-follow != nobody and not creates-following-circle? person-to-follow
  [
    let direction-ahead [heading] of person-to-follow
    let difference abs subtract-headings direction-ahead heading
    
    ifelse difference < 60 [
      set current-direction person-to-follow
      face current-direction
      set direction-chosen? false
      not-move-in-wall
      set color pink
    ]
    [set color blue follow-node-direction]
  ] 
  [set color blue follow-node-direction]
end


to-report creates-following-circle? [person]
  if person = nobody [ report false ]
  if person = self [ report true ]
  if [following-person] of person = nobody [ report false ]
  report creates-following-circle? [following-person] of person
end


to move
  

  let exits patches in-radius 5 with [pcolor = red]

  ifelse any? exits 
  [
    let target min-one-of exits [distance myself]
    face target

    not-move-in-wall
    set color green
  ]
  [
    follow-person-infront
    
  ]
end

to not-move-in-wall
  let tries 0
  
  while [tries < 4] [
    ifelse patch-ahead 1 != nobody and [pcolor] of patch-ahead 1 != black
    [
      fd 1
      set tries 4
    ]
    [
      rt 90
      set tries tries + 1
      set color red
    ]
  ]
end

to exit-changed
  if available-exit = 1
  [
    
  ]
end


to update-direction-on-node [coorx coory new-dir]
  ask nodes with [xcor = coorx and ycor = coory]
  [
    set directions (list new-dir)
    set heading new-dir
  ]
end


to on-stairs-left
  if ([pxcor] of patch-here >= 38 and [pxcor] of patch-here <= 49 and [pycor] of patch-here >= 42 and [pycor] of patch-here <= 56)
  or ([pxcor] of patch-here >= 22 and [pxcor] of patch-here <= 30 and [pycor] of patch-here >= 42 and [pycor] of patch-here <= 56)
  [
    if heading > 270 or heading < 90 [set current-direction 0]
    if heading > 90 and heading < 270[set current-direction 180]
  ]
  
  if [pxcor] of patch-here >= 38 and [pxcor] of patch-here <= 42 and [pycor] of patch-here = 42
  [
    move-to patch (random 4 + 26) 43
    ifelse is-turtle? current-direction 
    [face (current-direction)]
    [set current-direction (current-direction + 180)
      set direction-chosen? true
      set heading current-direction]
    fd 1
  ]
  if [pxcor] of patch-here >= 26 and [pxcor] of patch-here <= 30 and [pycor] of patch-here = 42
  [
    move-to patch (random 5 + 38) 43
    ifelse is-turtle? current-direction 
    [face (current-direction)]
    [set current-direction (current-direction + 180)
      set direction-chosen? true
      set heading current-direction]
    fd 1
  ]
  
  if [pxcor] of patch-here >= 20 and [pxcor] of patch-here <= 24 and [pycor] of patch-here = 42
  [
    move-to patch (random 5 + 20) 84
    ifelse is-turtle? current-direction 
    [face (current-direction)]
    [
      set direction-chosen? true
      set heading current-direction]
    fd 1
  ]
end
to on-stairs-right
  if ([pxcor] of patch-here >= 165 and [pxcor] of patch-here <= 175 and [pycor] of patch-here >= 49 and [pycor] of patch-here <= 60)
  or ([pxcor] of patch-here >= 184 and [pxcor] of patch-here <= 195 and [pycor] of patch-here >= 61 and [pycor] of patch-here <= 72)
  [
    if heading < 180 [set current-direction 90]
    if heading > 180 [set current-direction 270]
  ]
  
  if [pxcor] of patch-here = 165 and [pycor] of patch-here >= 55 and [pycor] of patch-here <= 60
  [
    move-to patch 185 (random 5 + 61)
    ifelse is-turtle? current-direction 
    [face (current-direction)]
    [set heading current-direction + 180]
    fd 1
  ]
  if [pxcor] of patch-here = 184 and [pycor] of patch-here >= 61 and [pycor] of patch-here <= 65
  [
    move-to patch 166 (random 5 + 55)
    ifelse is-turtle? current-direction 
    [face (current-direction)]
    [set heading current-direction + 180]
    fd 1
  ]
  if [pxcor] of patch-here = 184 and [pycor] of patch-here >= 67 and [pycor] of patch-here <= 72
  [
    move-to patch 184 (random 5 + 78)
    ifelse is-turtle? current-direction 
    [face (current-direction)]
    [
      set current-direction (current-direction + 180)
      set direction-chosen? true
      set heading current-direction]
    fd 1
  ]
  
end

to on-cooridor
  if [pxcor] of patch-here >= 60 and [pxcor] of patch-here <= 79 and [pycor] of patch-here >= 75 and [pycor] of patch-here <= 79 
  [
    if heading < 180 [set current-direction 90]
    if heading > 180 [set current-direction 270]
  ]
  
  
end]]></code>
