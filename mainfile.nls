;; ---------------- Setup --------------------------------------------
to bfs
  let s length queue

  while [s > 0] [
    let i 0

    while [i < s] [
      let curr first queue
      let curr-dist [dist] of curr

      ask curr [
        ask neighbors4 with [
          dist = -1 and
          (pcolor = white or pcolor = 9 or
           pcolor = green or pcolor = grey or
           pcolor = red)
        ] [
          set dist curr-dist + 1
          set queue lput self queue
        ]
      ]

      set queue but-first queue
      set i i + 1
    ]

    set s length queue
  ]
end

;; --------------------- Cumulative Setup -----------------------------------
to setup

  clear-all
  set queue []

  setup-world
  setup-exits
  setup-stairs
  setup-doors
  setup-coordinates
  setup-rooms-and-corridors
  setup-nodes
  bfs
  
  setup-civilians

  set group_count 0
  setup-group


  reset-ticks
end
;; --------------------- Civilian Setup ------------------------------------------------------------
to setup-civilians

  ask n-of civilians-count  (patches with [pcolor = 9 ]  ) [sprout-civilians 1]
  ask civilians
  [
    set shape "person"
    set color cyan - 1
    set size 2
    set target-direction ""

    ifelse random 100 < Percentage-know-exits
    [
      set know-exit true
      set color magenta
    ]
    [ set know-exit false]

    set vision-distance civilian-vision-distance
    set vision-angle civilian-vision-angle
    set journey_list []
    set direction_moved 0
    set leader? false
    set group_no 0

  ]

end

to setup-group
  ask civilians
  [
    if random 1000 < 5
    [
      set group_count group_count + 1
      set group_no group_count
      set leader? true
      set color orange

      let no-of-civilian_buddies count civilians in-radius 4

      let no-of-people min list no-of-civilian_buddies  4

      ask n-of no-of-people civilians in-radius 4
      [
        set group_no group_count
        set color orange
      ]
    ]
  ]

end

to setup-nodes
  create-nodes 8
  [
    set danger-active false
    set color 44
    set shape "square"
  ]
  
  ask node 0 [
    setxy 52 62
    set show-direction "left"
  ]

  ask node 1 [
    setxy 75 62
    set show-direction "left"
  ]

  ask node 2 [
    setxy 84 62
    set show-direction "left"
  ]
  ask node 3 [
    setxy 47 40
    set show-direction "right" 
  ]
  ask node 4 [
    setxy 56 52
    set show-direction "right" ;kontroll så gubbar faktiskt följer pilen 
  ]

  ask node 5 [
    setxy 76 52
    set show-direction "right"
  ]

  ask node 6 [
    setxy 96 52
    set show-direction "down" 
  ]
  ask node 7 [
    setxy 106 42
    set show-direction "left"
  ]
end



;; ----------------------------- Setup Environment  ---------------------------------------------------------------------------------------
to setup-coordinates
  set exit-1-xcor 10
  set exit-1-ycor 43

  set exit-2-xcor 143
  set exit-2-ycor 43

  set people-reached-safe-zone 0
  set people-killed-by-terrorists 0
  set people-killed-by-stampede 0
end



to setup-world

  import-pcolors "orkanenA3.png"
  ask patches with [pcolor >= 0 and pcolor <= 9.2 ]
  [
    set pcolor black
    set p_type "walls"
  ]
  ask patches with [pcolor != black ] [ set pcolor white ]
  ask patches with [pcolor = black or pcolor = yellow ] [ set dist 100000 ]

end

to setup-exits
  ask patches [
     if pcolor = white [
      set dist -1
    ]
    if pxcor >= 143 and pxcor <= 144 and pycor >= 42 and pycor <= 43 [set pcolor red set p_type "safe" set dist 0 set queue lput self queue]
    if pxcor >= 10 and pxcor <= 11 and pycor >= 39 and pycor <= 40 [set pcolor red set p_type "safe" set dist 0 set queue lput self queue]
    ;if pxcor >= 73 and pxcor <= 78 and pycor >= 50 and pycor <= 51 [set pcolor red set p_type "safe" set dist 0 set queue lput self queue]
  ]
end

to setup-doors
  ask patches [
    if pxcor = 48 and pycor >= 39  and pycor <= 43 [set pcolor green set p_type "door" ]
    if pxcor >= 50 and pxcor <= 53 and pycor = 61 [set pcolor green set p_type "door" ]
    if pxcor >= 74 and pxcor <= 77 and pycor = 61 [set pcolor green set p_type "door" ]
    if pxcor >= 82 and pxcor <= 85 and pycor = 61 [set pcolor green set p_type "door" ]
    if pxcor = 62 and pycor >= 66 and pycor <= 68 [set pcolor green set p_type "door" ]
    if pxcor = 105 and pycor >= 39 and pycor <= 43 [set pcolor green set p_type "door" ]
  ]
end

